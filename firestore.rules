rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Daily ledger access is restricted to users authenticated by Firebase Auth.
    // firebase.json deploys these rules to the named database used by the app.
    match /daily_records/{recordId} {
      allow read, write: if request.auth != null;
    }

    // Each account owns a single workspace/company profile.
    match /company_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny every collection that is not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
